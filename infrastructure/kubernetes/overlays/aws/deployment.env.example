# Relay AWS deployment configuration template
# Copy to a private local file if you need to customize it; never add credentials here.
# These values are documentation until connected to a deployment workflow.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
ECR_IMAGE_TAG=REPLACE_WITH_IMAGE_TAG
APP_DOMAIN=relay.example.com
ACM_CERTIFICATE_ARN=REPLACE_WITH_ACM_CERTIFICATE_ARN
K8S_NAMESPACE=relay
EKS_CLUSTER_NAME=REPLACE_WITH_EKS_CLUSTER_NAME
AI_ENDPOINT_URL=REPLACE_WITH_CLUSTER_REACHABLE_AI_ENDPOINT
