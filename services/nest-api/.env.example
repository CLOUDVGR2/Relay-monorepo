PORT=3000
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatapp_nest

# MongoDB connection used for existing user accounts
MONGODB_URI=mongodb://localhost:27017/chatapp

# Use the same signing secret as the existing Express backend.
# Replace this placeholder with a strong secret of at least 32 characters.
JWT_SECRET=replace-with-a-strong-secret-of-at-least-32-characters

# Internal Atlas AI service (local development)
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
PYTHON_AI_INTERNAL_TOKEN=replace-with-the-same-secret-used-by-python-ai
GO_API_BASE_URL=http://127.0.0.1:8081
