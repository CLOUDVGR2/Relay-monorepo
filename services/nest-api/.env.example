PORT=3000
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatapp_nest

# MongoDB connection used for existing user accounts
MONGODB_URI=mongodb://localhost:27017/chatapp

# Use the same signing secret as the existing Express backend.
# Replace this placeholder with a strong secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Internal Atlas AI service (local development)
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
PYTHON_AI_INTERNAL_TOKEN=replace-with-the-same-secret-used-by-python-ai
GO_API_BASE_URL=http://127.0.0.1:8081

# Private object-storage endpoint used by NestJS for verification and deletion.
CALL_RECORDING_STORAGE_ENDPOINT=http://minio:9000

# Public HTTPS origin used only to generate upload URLs reachable by mobile devices.
# Replace with your deployed storage hostname or reachable reverse-proxy origin.
CALL_RECORDING_STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
CALL_RECORDING_STORAGE_BUCKET=relay-call-recordings
CALL_RECORDING_STORAGE_REGION=us-east-1
CALL_RECORDING_STORAGE_ACCESS_KEY_ID=replace-me
CALL_RECORDING_STORAGE_SECRET_ACCESS_KEY=replace-me
CALL_RECORDING_STORAGE_FORCE_PATH_STYLE=true
