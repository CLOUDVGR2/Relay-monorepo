{
  "name": "relay-monorepo",
  "version": "1.0.0",
  "description": "Relay microservices monorepo",
  "scripts": {
    "install:all": "corepack pnpm install",
    "build:all": "pnpm run build:express-api && pnpm run build:nest-api && pnpm run build:web && pnpm run build:jobs-api && pnpm run build:jobs-worker && pnpm run build:api-gateway",
    "test:all": "pnpm run test:express-api && pnpm run test:nest-api && pnpm run test:web && pnpm run test:ai-service && pnpm run test:jobs-api && pnpm run test:jobs-worker && pnpm run test:api-gateway",
    "docker:up": "docker compose -f compose.yaml up -d",
    "docker:down": "docker compose -f compose.yaml down",
    "docker:logs": "docker compose -f compose.yaml logs -f",
    "docker:build": "docker compose -f compose.yaml build",
    "test:jobs-api": "cd services/jobs-api && go test ./...",
    "test:jobs-worker": "cd services/jobs-worker && go test ./...",
    "build:express-api": "pnpm --filter @relay/express-api run build",
    "start:express-api": "pnpm --filter @relay/express-api run start",
    "dev:express-api": "pnpm --filter @relay/express-api run dev",
    "test:express-api": "pnpm --filter @relay/express-api run test:integration",
    "build:jobs-api": "cd services/jobs-api && go build ./...",
    "build:jobs-worker": "cd services/jobs-worker && go build ./...",
    "build:nest-api": "pnpm --filter @relay/nest-api run build",
    "build:web": "pnpm --filter @relay/web run build",
    "start:nest-api": "pnpm --filter @relay/nest-api run start",
    "start:web": "pnpm --filter @relay/web run dev",
    "dev:nest-api": "pnpm --filter @relay/nest-api run start:dev",
    "dev:web": "pnpm --filter @relay/web run dev",
    "test:web": "pnpm --filter @relay/web run test",
    "test:ai-service": "services/ai-service/.venv/bin/python -m pytest services/ai-service/tests/ -v",
    "test:e2e:nest-api": "pnpm --filter @relay/nest-api run test:e2e",
    "test:e2e:web": "pnpm --filter @relay/web run test:e2e",
    "test:nest-api": "pnpm --filter @relay/nest-api run test",
    "test:api-gateway": "cd services/api-gateway && go test ./...",
    "build:api-gateway": "cd services/api-gateway && go build ./...",
    "dev:mobile": "pnpm --filter @relay/mobile run start",
    "typecheck:mobile": "pnpm --filter @relay/mobile run typecheck"
  },
  "keywords": [
    "chat",
    "real-time",
    "socket.io",
    "nestjs",
    "express",
    "react"
  ],
  "license": "MIT",
  "dependencies": {
    "amqplib": "^2.2.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "packageManager": "pnpm@12.15.0",
  "private": true
}
