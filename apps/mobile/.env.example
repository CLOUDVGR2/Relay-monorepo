# Use a URL reachable from the device, ending in /api.
# iOS Simulator: http://localhost:5001/api
# Android Emulator: http://10.0.2.2:5001/api
# Physical device: https://your-dev-api.example.com/api (or your LAN IP for local testing)
# Production must use HTTPS; never ship secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://localhost:5001/api
