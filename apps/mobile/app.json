{
  "expo": {
    "name": "Relay",
    "slug": "relay-mobile",
    "scheme": "relay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.relay.mobile",
      "bitcode": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.relay.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Relay uses your microphone during audio calls."
        }
      ]
    ],
    "extra": {
      "apiUrlHelp": "Set EXPO_PUBLIC_API_URL to your reachable HTTPS API base URL ending in /api. Use a LAN IP for a physical device.",
      "eas": {
        "projectId": "8bb6adca-f08c-4d23-8fa7-b605fba56146"
      }
    }
  }
}
